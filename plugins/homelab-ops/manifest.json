{
  "id": "homelab-ops",
  "name": "Homelab Ops & Telemetry Inspector",
  "version": "1.0.0",
  "author": "Astra Navi Contributors",
  "description": "Optional read-only Proxmox/ZFS pool health, SMART NVMe wear, and UPS telemetry parser with approval-gated service restarts.",
  "defaultEnabled": false,
  "bridgeKind": "custom",
  "bridges": [
    "custom"
  ],
  "entry": "index.ts",
  "permissions": [
    "read_workspace",
    "register_tool"
  ],
  "tools": [
    {
      "name": "plugin:homelab.health_summary",
      "description": "Evaluate heavy-job policy from LAN storage/UPS/GPU telemetry.",
      "requiredScope": "read_workspace",
      "readOnly": true,
      "endpointHost": "192.168.50.14"
    },
    {
      "name": "plugin:homelab.smart_parse",
      "description": "Parse raw smartctl/zpool/upsc text read-only.",
      "requiredScope": "read_workspace",
      "readOnly": true
    },
    {
      "name": "plugin:homelab.service_restart",
      "description": "Request an approved service or container restart on a LAN host.",
      "requiredScope": "register_tool",
      "readOnly": false,
      "endpointHost": "192.168.50.14"
    }
  ],
  "evalCases": [
    {
      "name": "health summary allowed read-only on LAN",
      "tool": "plugin:homelab.health_summary",
      "args": {
        "host": "192.168.50.14"
      },
      "expectDecision": "allow"
    },
    {
      "name": "smart parse allowed read-only",
      "tool": "plugin:homelab.smart_parse",
      "args": {
        "zpoolOutput": "all pools are healthy"
      },
      "expectDecision": "allow"
    },
    {
      "name": "health summary escalates to ask after outside text",
      "tool": "plugin:homelab.health_summary",
      "args": {
        "host": "192.168.50.14"
      },
      "readOutsideText": true,
      "expectDecision": "ask"
    },
    {
      "name": "service restart requires confirmation",
      "tool": "plugin:homelab.service_restart",
      "args": {
        "host": "192.168.50.14",
        "unit": "pveproxy"
      },
      "expectDecision": "ask"
    },
    {
      "name": "hands-off blocks service restart",
      "tool": "plugin:homelab.service_restart",
      "args": {
        "host": "192.168.50.14",
        "unit": "pveproxy"
      },
      "handsOff": true,
      "expectDecision": "blocked"
    }
  ],
  "sha256": "443a31e8f0bc1949c16a9ae44923845de9d1e6f28f32dfb166442f7589abdf74",
  "evalCasesCount": 5
}
