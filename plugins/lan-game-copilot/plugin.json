{
  "id": "lan-game-copilot",
  "name": "LAN Co-op & Game Telemetry Copilot",
  "version": "1.0.0",
  "author": "Astra Navi Contributors",
  "description": "Optional read-only LAN game server telemetry, match timers, and session overlay notes strictly limited to loopback or RFC1918 LAN hosts.",
  "defaultEnabled": false,
  "bridgeKind": "game_telemetry",
  "bridges": [
    "game_telemetry"
  ],
  "entry": "index.ts",
  "permissions": [
    "read_workspace",
    "read_active_window",
    "register_tool"
  ],
  "tools": [
    {
      "name": "plugin:game.telemetry_snapshot",
      "description": "Read local/LAN game telemetry snapshot with untrusted outsideText framing.",
      "requiredScope": "read_workspace",
      "readOnly": true,
      "endpointHost": "127.0.0.1"
    },
    {
      "name": "plugin:game.match_timer",
      "description": "Start or read a local co-op objective countdown timer.",
      "requiredScope": "read_active_window",
      "readOnly": true
    },
    {
      "name": "plugin:game.overlay_note",
      "description": "Save a short HUD note to the local game overlay buffer.",
      "requiredScope": "register_tool",
      "readOnly": false
    }
  ],
  "evalCases": [
    {
      "name": "telemetry snapshot allowed read-only on localhost",
      "tool": "plugin:game.telemetry_snapshot",
      "args": {
        "host": "127.0.0.1",
        "game": "factorio"
      },
      "expectDecision": "allow"
    },
    {
      "name": "match timer read allowed read-only",
      "tool": "plugin:game.match_timer",
      "args": {
        "label": "boss",
        "action": "read"
      },
      "expectDecision": "allow"
    },
    {
      "name": "telemetry snapshot escalates to ask after outside text",
      "tool": "plugin:game.telemetry_snapshot",
      "args": {
        "host": "192.168.50.14"
      },
      "readOutsideText": true,
      "expectDecision": "ask"
    },
    {
      "name": "overlay note write requires confirmation",
      "tool": "plugin:game.overlay_note",
      "args": {
        "text": "Check smelter belt"
      },
      "expectDecision": "ask"
    },
    {
      "name": "hands-off blocks overlay note write",
      "tool": "plugin:game.overlay_note",
      "args": {
        "text": "Check smelter belt"
      },
      "handsOff": true,
      "expectDecision": "blocked"
    }
  ],
  "sha256": "eca5312cdee97ac4d10b0aaa05b60f527dcbc0175e38982be446540c622bf4ce",
  "evalCasesCount": 5
}
