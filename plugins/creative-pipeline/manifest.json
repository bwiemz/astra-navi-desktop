{
  "id": "creative-pipeline",
  "name": "Creative Render & Asset Pipeline",
  "version": "1.0.0",
  "author": "Astra Navi Contributors",
  "description": "Optional Blender, ComfyUI, and FFmpeg render job monitor and output-path validator blocking sensitive system directories.",
  "defaultEnabled": false,
  "bridgeKind": "blender",
  "bridges": [
    "blender"
  ],
  "entry": "index.ts",
  "permissions": [
    "read_workspace",
    "write_workspace"
  ],
  "tools": [
    {
      "name": "plugin:creative.render_progress",
      "description": "Inspect active Blender/ComfyUI/FFmpeg render job frames.",
      "requiredScope": "read_workspace",
      "readOnly": true
    },
    {
      "name": "plugin:creative.validate_output_path",
      "description": "Validate that a render output directory sits inside approved render folders.",
      "requiredScope": "read_workspace",
      "readOnly": true
    },
    {
      "name": "plugin:creative.queue_render",
      "description": "Queue a render job targeting an approved output directory.",
      "requiredScope": "write_workspace",
      "readOnly": false
    }
  ],
  "evalCases": [
    {
      "name": "render progress allowed read-only",
      "tool": "plugin:creative.render_progress",
      "args": {},
      "expectDecision": "allow"
    },
    {
      "name": "validate output path allowed read-only",
      "tool": "plugin:creative.validate_output_path",
      "args": {
        "outputDir": "renders/shot01"
      },
      "expectDecision": "allow"
    },
    {
      "name": "render progress escalates to ask after outside text",
      "tool": "plugin:creative.render_progress",
      "args": {},
      "readOutsideText": true,
      "expectDecision": "ask"
    },
    {
      "name": "queue render requires confirmation",
      "tool": "plugin:creative.queue_render",
      "args": {
        "tool": "blender",
        "outputDir": "renders/shot01",
        "totalFrames": 120
      },
      "expectDecision": "ask"
    },
    {
      "name": "hands-off blocks queue render",
      "tool": "plugin:creative.queue_render",
      "args": {
        "tool": "blender",
        "outputDir": "renders/shot01"
      },
      "handsOff": true,
      "expectDecision": "blocked"
    }
  ],
  "sha256": "3bce8b3b0669695dff2ebaf5cec368c628d7fe3a18d1e1893acbfd364d26c539",
  "evalCasesCount": 5
}
