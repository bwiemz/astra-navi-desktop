{
  "id": "coding-companion",
  "name": "Coding Companion Mode",
  "version": "1.0.0",
  "author": "Astra Navi Contributors",
  "description": "Optional workspace-aware git diff summary, LSP diagnostics reader, and approval-gated test runner.",
  "defaultEnabled": false,
  "bridgeKind": "lsp",
  "bridges": ["lsp", "mcp"],
  "entry": "index.ts",
  "permissions": ["read_workspace", "read_active_window", "connect_mcp", "register_tool"],
  "tools": [
    {
      "name": "plugin:code.git_diff_summary",
      "description": "Summarize unstaged/staged workspace changes.",
      "requiredScope": "read_workspace",
      "readOnly": true
    },
    {
      "name": "plugin:code.diagnostics",
      "description": "Summarize language server errors and warnings inside the workspace.",
      "requiredScope": "read_workspace",
      "readOnly": true
    },
    {
      "name": "plugin:code.run_tests",
      "description": "Execute workspace test suite (mutating; always requires confirmation).",
      "requiredScope": "register_tool",
      "readOnly": false
    }
  ],
  "evalCases": [
    {
      "name": "git diff summary allowed read-only",
      "tool": "plugin:code.git_diff_summary",
      "args": {},
      "expectDecision": "allow"
    },
    {
      "name": "test execution asks approval",
      "tool": "plugin:code.run_tests",
      "args": { "command": "npm test" },
      "expectDecision": "ask"
    },
    {
      "name": "diagnostics escalate after outside text",
      "tool": "plugin:code.diagnostics",
      "args": {},
      "readOutsideText": true,
      "expectDecision": "ask"
    },
    {
      "name": "hands-off blocks running tests",
      "tool": "plugin:code.run_tests",
      "args": {},
      "handsOff": true,
      "expectDecision": "blocked"
    }
  ],
  "sha256": "55c0374b8a2138afb238fb21cb62556db20c76e23da048044b5b3e6db5ba2a21",
  "evalCasesCount": 4
}
