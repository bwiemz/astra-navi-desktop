<?xml version="1.0" encoding="utf-8"?>
<!--
  Astra Navi's station on a phone: an open-source mobile companion. It is a window onto
  the page the desktop app serves on the home network, and holds nothing of the model.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.astranavi.station">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by JobScheduler jobs with NETWORK_TYPE_ANY for background standing-order polling. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- For letting this phone back in to her by its own fingerprint or face check. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- For hold-to-talk voice notes sent straight to local Whisper transcription. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- For background standing-order notifications on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Station"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|locale|layoutDirection|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The page's "open in the app" link: astranavi://station?at=…&fp=…&code=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="station" android:scheme="astranavi" />
            </intent-filter>
        </activity>
        <service
            android:name=".AlertPollerService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".PushToTalkTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tile_ptt_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver
            android:name=".VoiceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_talk_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/voice_widget_info" />
        </receiver>
        <receiver
            android:name=".ApprovalActionReceiver"
            android:exported="false" />
    </application>
</manifest>
